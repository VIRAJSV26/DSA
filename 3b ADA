#include <stdio.h>
#define MAX 20
void warshall(int n, int reach[MAX][MAX]) {
int i, j, k;
for (k = 0; k < n; k++) {
for (i = 0; i < n; i++) {
for (j = 0; j < n; j++) {
reach[i][j] = reach[i][j] || (reach[i][k] && reach[k][j]);
}
}
}
}
int main() {
int n, i, j;
int reach[MAX][MAX];
printf("Enter number of vertices: ");
scanf("%d", &n);
printf("Enter adjacency matrix (0 or 1):\n");
for (i = 0; i < n; i++) {
for (j = 0; j < n; j++) {
scanf("%d", &reach[i][j]);
}
}
warshall(n, reach);
printf("\nTransitive closure matrix:\n");
for (i = 0; i < n; i++) {
for (j = 0; j < n; j++) {
printf("%d ", reach[i][j]);
}
printf("\n");
}
return 0;
}