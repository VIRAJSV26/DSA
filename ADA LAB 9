Design and implement C/C++ Program to sort a given set of n integer elements using
Selection Sort method and compute its time complexity. Run the program for varied values
of n> 5000 and record the time taken to sort. Plot a graph of the time taken versus n. The
elements can be read from a file or can be generated using the random number generator.
#include
#include
#include
using namespace std;
void selectionSort(int arr[ ], int n)
{
int minIndex, temp;
for(int i = 0; i < n-1; i++)
{
minIndex = i;
for(int j = i+1; j < n; j++)
{
if(arr[j] < arr[minIndex])
minIndex = j;
}
// Swap
temp = arr[i];
arr[i] = arr[minIndex];
arr[minIndex] = temp;
}
}
int main()
{
int n;
cout << "Enter number of elements: ";
cin >> n;
int arr[n];
srand(time(0)); // seed for random numbers
// Generate random numbers
for(int i = 0; i < n; i++)
arr[i] = rand() % 100;
cout << "\nUnsorted Array:\n";
for(int i = 0; i < n; i++)
cout << arr[i] << " ";
clock_t start, end;
start = clock();
selectionSort(arr, n);
end = clock();
cout << "\n\nSorted Array:\n";
for(int i = 0; i < n; i++)
cout << arr[i] << " ";
double time_taken = double(end - start) / CLOCKS_PER_SEC;
cout << "\n\nTime taken: " << time_taken << " seconds\n";
return 0;
}