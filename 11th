#include <stdio.h> 
#define MAX 20 
int adj[MAX][MAX]; 
int visited[MAX]; 
int n; 
/* DFS Function */ 
void DFS(int v) 
{ 
int i; 
visited[v] = 1; 
printf("%d ", v); 
for (i = 0; i < n; i++) 
{ 
if (adj[v][i] == 1 && visited[i] == 0) 
DFS(i); 
} 
} 
/* BFS Function */ 
void BFS(int start) 
{ 
int queue[MAX], front = 0, rear = -1; 
int i; 
for (i = 0; i < n; i++) 
visited[i] = 0; 
visited[start] = 1; 
queue[++rear] = start; 
while (front <= rear) 
{ 
int v = queue[front++]; 
printf("%d ", v); 
for (i = 0; i < n; i++) 
{ 
if (adj[v][i] == 1 && visited[i] == 0) 
{ 
visited[i] = 1; 
queue[++rear] = i; 
} 
        } 
    } 
} 
 
int main() 
{ 
    int i, j, start, choice; 
 
    printf("Enter number of cities: "); 
    scanf("%d", &n); 
 
    printf("Enter adjacency matrix:\n"); 
    for (i = 0; i < n; i++) 
        for (j = 0; j < n; j++) 
            scanf("%d", &adj[i][j]); 
 
    printf("Enter starting city (0 to %d): ", n - 1); 
    scanf("%d", &start); 
 
    printf("\nEnter choice:\n"); 
    printf("1. BFS\n"); 
    printf("2. DFS\n"); 
    printf("Choice: "); 
    scanf("%d", &choice); 
 
    for (i = 0; i < n; i++) 
        visited[i] = 0; 
 
    switch (choice) 
    { 
        case 1: 
            printf("\nCities reachable using BFS:\n"); 
            BFS(start); 
            break; 
 
        case 2: 
            printf("\nCities reachable using DFS:\n"); 
            DFS(start); 
            break; 
 
        default: 
            printf("Invalid choice"); 
    } 
 
    return 0; 
}
