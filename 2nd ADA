#include <stdio.h>
#include <limits.h>
#define MAX 100
int main()
{
int n, cost[MAX][MAX];
int visited[MAX] = {0};
int min, mincost = 0;
int a = 0, b = 0;
printf("Enter number of vertices: ");
scanf("%d", &n);
printf("Enter the adjacency matrix:\n");
for(int i = 0; i < n; i++)
{
for(int j = 0; j < n; j++)
{
scanf("%d", &cost[i][j]);
if(i == j)
cost[i][j] = INT_MAX;
else if(cost[i][j] == 0)
cost[i][j] = INT_MAX;
}
}
visited[0] = 1;
printf("\nEdges in Minimum Spanning
Tree:\n");
for(int k = 0; k < n - 1; k++)
{
min = INT_MAX;
for(int i = 0; i < n; i++)
{
if(visited[i])
{
for(int j = 0; j < n; j++)
{
if(!visited[j] && cost[i][j] <
min)
{
min = cost[i][j];
a = i;
b = j;
}
}
}
}
if(min == INT_MAX)
{
printf("Graph is not
connected!\n");
return 0;
}
printf("%d -> %d : %d\n", a, b,
min);
mincost += min;
visited[b] = 1;
}
printf("\nMinimum Cost = %d\n",
mincost);
return 0;
}