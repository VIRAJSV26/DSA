#include <stdio.h> 
#include <stdlib.h> 
 
struct node 
{ 
    int data; 
    struct node *next; 
}; 
struct node *first; 
 
void create_first() 
{ 
    first = (struct node *)malloc(sizeof(struct node)); 
    first->data = 0;      // count of nodes 
    first->next = first; // circular 
} 
 
/* Insert at End */ 
void insert_end(int item) 
{ 
    struct node *temp, *cur; 
    temp = (struct node *)malloc(sizeof(struct node)); 
    temp->data = item; 
    cur = first; 
    while (cur->next != first) 
       {  cur = cur->next; } 
    cur->next = temp; 
    temp->next = first; 
    first->data++; 
} 
 
/* Insert at Front */ 
void insert_front(int item) 
{ 
    struct node *temp; 
    temp = (struct node *)malloc(sizeof(struct node)); 
    temp->data = item; 
    temp->next = first->next; 
    first->next = temp; 
    first->data++; 
} 
 
/* Delete from Front */ 
void delete_front() 
{ 
    struct node *temp; 
    if (first->next == first) 
    { 
        printf("List is empty\n"); 
        return; 
    } 
    temp = first->next; 
    first->next = temp->next; 
    printf("Deleted element: %d\n", temp->data); 
    free(temp); 
    first->data--; 
} 
 
/* Delete from End */ 
void delete_end() 
{ 
    struct node *prev, *cur; 
 
    if (first->next == first) 
    { 
        printf("List is empty\n"); 
        return; 
    } 
    prev = first; 
    cur = first->next; 
    while (cur->next != first) 
    { 
        prev = cur; 
        cur = cur->next; 
    } 
    prev->next = first; 
    printf("Deleted element: %d\n", cur->data); 
    free(cur); 
    first->data--; 
} 
 
/* Display List */ 
void display() 
{ 
    struct node *cur; 
    if (first->next == first) 
    { 
        printf("List is empty\n"); 
        return; 
    } 
    printf("SCLL elements: "); 
    cur = first->next; 
    while (cur != first) 
    { 
        printf("%d ", cur->data); 
        cur = cur->next; 
    } 
    printf("\nTotal nodes = %d\n", first->data); 
} 
 
/* Main Function */ 
int main() 
{ 
    int choice, item, n, i; 
    create_first(); 
    while (1) 
    { 
        printf("\n--- Singly Circular Linked List ---\n"); 
        printf("1. Create List\n"); 
        printf("2. Display List\n"); 
        printf("3. Insert at Front\n"); 
        printf("4. Insert at End\n"); 
        printf("5. Delete from Front\n"); 
        printf("6. Delete from End\n"); 
        printf("7. Exit\n"); 
        printf("Enter your choice: "); 
        scanf("%d", &choice); 
        switch (choice) 
        { 
        case 1: 
            printf("Enter number of nodes: "); 
            scanf("%d", &n); 
            for (i = 0; i < n; i++) 
            { 
                printf("Enter data: "); 
                scanf("%d", &item); 
                insert_end(item); 
            } 
            break; 
        case 2: 
            display(); 
            break; 
        case 3: 
            printf("Enter data: "); 
            scanf("%d", &item); 
            insert_front(item); 
            break; 
        case 4: 
            printf("Enter data: "); 
            scanf("%d", &item); 
            insert_end(item); 
            break; 
        case 5: 
            delete_front(); 
            break; 
        case 6: 
            delete_end(); 
            break; 
        case 7: 
            exit(0); 
        default: 
            printf("Invalid choice\n"); 
        } 
    } 
}
